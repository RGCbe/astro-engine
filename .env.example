# Copy to .env or set in PM2 ecosystem.config.cjs
ATRO_ROOT=F:/astro
ATRO_EPHE=F:/astro/ephe

# Comma-separated key:tier or JSON {"my-secret-key":"professional"}
ATRO_API_KEYS=

# Local dev only � enables atro_pro_dev_key etc. (never use in public production)
ATRO_ALLOW_DEV_KEYS=1

# CORS origins (comma-separated). Use * only for isolated testing.
ATRO_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Optional: PyJHora cross-check repo
# ATRO_PYJHORA_PATH=/opt/astro/_research/repos/PyJHora/src
